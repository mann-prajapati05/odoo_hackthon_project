DATABASE_URL=postgresql://user:pass@localhost:5432/coreinventory
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=<random_64_char_hex>
JWT_REFRESH_SECRET=<different_random_64_char_hex>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=<random_32_char_hex>
CORS_ORIGIN=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CoreInventory <noreply@coreinventory.com>

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SIGNUP_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_PROVIDER=cloudinary

FRONTEND_URL=http://localhost:5173
